# Public frontend configuration. These VITE_ values are embedded in the browser bundle.
# Staging is pinned in code to the isolated project qgppeyplrrgiedsvsvst.
VITE_APP_TARGET="staging"
VITE_SUPABASE_URL="https://qgppeyplrrgiedsvsvst.supabase.co"
VITE_SUPABASE_ANON_KEY="REPLACE_WITH_ISOLATED_PROJECT_PUBLISHABLE_KEY"

# GitHub Pages project-site path. Use "/" when the app is served from a domain root.
VITE_BASE_PATH="/s-trainerapp/"

# Production variables are intentionally omitted from this example file. The production
# GitHub Environment must define PRODUCTION_SUPABASE_URL and
# PRODUCTION_SUPABASE_PUBLISHABLE_KEY. The URL is allowlisted in src/lib/supabaseTarget.mjs.
# Cloudflare deployment also requires CLOUDFLARE_ACCOUNT_ID (variable) and
# CLOUDFLARE_API_TOKEN (secret) in that protected GitHub Environment.
# APP_URL/SITE_URL belong to Supabase Edge Function configuration, not this frontend.
