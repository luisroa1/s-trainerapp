# Public frontend configuration. These VITE_ values are embedded in the browser bundle.
# Staging is pinned in code to the isolated project qgppeyplrrgiedsvsvst.
VITE_APP_TARGET="staging"
VITE_SUPABASE_URL="https://qgppeyplrrgiedsvsvst.supabase.co"
VITE_SUPABASE_ANON_KEY="REPLACE_WITH_ISOLATED_PROJECT_PUBLISHABLE_KEY"

# GitHub Pages project-site path. Use "/" when the app is served from a domain root.
VITE_BASE_PATH="/s-trainerapp/"

# APP_URL/SITE_URL belong to the Supabase Edge Function environment, not the frontend.
# Configure them there to the full application base URL when the function needs a fallback.
# VITE_APP_TARGET=production is intentionally blocked until its Supabase URL is explicitly approved and allowlisted.
